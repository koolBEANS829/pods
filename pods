#!/usr/bin/python3
# Must be Fedora's own Python: Homebrew's python3 has no Bluetooth sockets.
"""pods — AirPods controller.

  pods anc | transparency | adaptive | off    set noise control
  pods battery                                 left / right / case
  pods status                                  connection, mode, battery
  pods run                                     the app (started at login by pods.service)
"""
import logging
import os
import signal
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))  # find pods_app/ even through the ~/.local/bin symlink

from pods_app.client import COMMANDS, ask, socket_path  # noqa: E402  (stdlib only — keeps the CLI fast)

log = logging.getLogger("pods")


def describe(ev):
    from pods_app import aap
    from pods_app.control import battery_text
    if isinstance(ev, aap.Battery):
        return "battery: " + battery_text(ev).replace("\n", "  ")
    if isinstance(ev, aap.Ear):
        return f"ear: primary {ev.primary}, secondary {ev.secondary}"
    if isinstance(ev, aap.Noise):
        return f"noise: {ev.mode}"
    return repr(ev)


def run():
    from PySide6.QtWidgets import QApplication
    from pods_app import aap, config
    from pods_app.control import AlreadyRunning, Control
    from pods_app.link import Link
    from pods_app.media import EarPause, Media
    from pods_app.tray import Tray

    logging.basicConfig(level=logging.DEBUG if os.environ.get("PODS_DEBUG") else logging.INFO,
                        format="%(asctime)s %(message)s", datefmt="%H:%M:%S")
    signal.signal(signal.SIGINT, signal.SIG_DFL)  # Ctrl+C quits even while Qt is busy
    app = QApplication(sys.argv)
    app.setQuitOnLastWindowClosed(False)

    link = Link()
    control = Control(link, socket_path())
    try:
        control.listen()
    except AlreadyRunning as e:
        print(e, file=sys.stderr)
        return 1

    tray = Tray(link)  # noqa: F841  (kept alive for the life of the app)
    ear_pause = EarPause(config.load()["pause_when"])
    media = Media()

    def on_event(ev):
        log.info(describe(ev))
        if isinstance(ev, aap.Ear):
            action = ear_pause.update(ev)
            if action == "pause":
                media.pause()
            elif action == "resume":
                media.resume()

    link.up.connect(lambda: log.info("link up"))
    link.up.connect(ear_pause.reset)  # so the first ear packet after connecting never starts music
    link.up.connect(media.forget)
    link.down.connect(lambda: log.info("link lost"))
    link.event.connect(on_event)
    link.start()
    code = app.exec()
    control.close()
    return code


def main(argv):
    if argv == ["run"]:
        return run()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if len(argv) != 1 or argv[0] not in COMMANDS:
        print(f"pods: unknown command '{' '.join(argv)}' (try: {', '.join(COMMANDS)})", file=sys.stderr)
        return 1
    ok, text = ask(socket_path(), argv[0])
    print(text, file=sys.stdout if ok else sys.stderr)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
